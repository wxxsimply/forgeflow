FORGEFLOW_RELEASE=0.11.0
FORGEFLOW_REGISTRY=local
FORGEFLOW_DOMAIN=forgeflow-staging.example.com
ACME_EMAIL=ops@example.com
FORGEFLOW_REPOSITORY_PATH=/srv/forgeflow/repositories
FORGEFLOW_LOG_LEVEL=info
FORGEFLOW_OTEL_SAMPLE_RATIO=0.1
FORGEFLOW_WORKFLOW_MODE=planning
FORGEFLOW_PLANNER_MODE=mock
FORGEFLOW_DOCKER_ENABLED=false
# Required only when Docker sandbox is enabled; always pin by digest.
# FORGEFLOW_SANDBOX_IMAGE=registry.example.com/forgeflow-sandbox@sha256:<digest>

# Staging tags are explicit. Before a production promotion, replace every
# third-party tag with image@sha256:digest and record it in the release manifest.
POSTGRES_IMAGE=postgres:17.10-alpine3.23
CADDY_IMAGE=caddy:2.11.4-alpine
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector:0.157.0
PROMETHEUS_IMAGE=prom/prometheus:v3.12.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.32.1
DOCKER_DIND_IMAGE=docker:28.4-dind
