FORGEFLOW_RELEASE=0.12.0-rc.1
FORGEFLOW_GIT_COMMIT=<approved-40-character-git-sha>
FORGEFLOW_DOMAIN=forgeflow-staging.example.com
ACME_EMAIL=ops@example.com
FORGEFLOW_REPOSITORY_PATH=/srv/forgeflow/repositories
FORGEFLOW_LOG_LEVEL=info
FORGEFLOW_OTEL_SAMPLE_RATIO=0.1
FORGEFLOW_WORKFLOW_MODE=planning
FORGEFLOW_PLANNER_MODE=mock
FORGEFLOW_DOCKER_ENABLED=false
FORGEFLOW_GOVERNANCE_ENFORCE_ACTIVE_RELEASES=true
# One-time bootstrap only. Uncomment before -IncludeBootstrap, then remove it.
# FORGEFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Replace every placeholder with a real digest from the approved release
# manifest or the reviewed third-party image inventory. Tags are forbidden
# when staging-release.ps1 invokes the production-grade preflight.
FORGEFLOW_API_IMAGE=ghcr.io/wxxsimply/forgeflow-api@sha256:<digest>
FORGEFLOW_WORKER_IMAGE=ghcr.io/wxxsimply/forgeflow-worker@sha256:<digest>
FORGEFLOW_WEB_IMAGE=ghcr.io/wxxsimply/forgeflow-web@sha256:<digest>
FORGEFLOW_CADDY_IMAGE=ghcr.io/wxxsimply/forgeflow-caddy@sha256:<digest>
FORGEFLOW_SANDBOX_IMAGE=ghcr.io/wxxsimply/forgeflow-sandbox@sha256:<digest>
POSTGRES_IMAGE=postgres@sha256:<digest>
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector@sha256:<digest>
PROMETHEUS_IMAGE=prom/prometheus@sha256:<digest>
ALERTMANAGER_IMAGE=prom/alertmanager@sha256:<digest>
DOCKER_DIND_IMAGE=docker@sha256:<digest>
