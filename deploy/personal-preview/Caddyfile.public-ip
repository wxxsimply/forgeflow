{
	admin off
	auto_https disable_redirects
	email {$FORGEFLOW_ACME_EMAIL}
	log {
		output stdout
		format json
	}
}

(forgeflow_proxy) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	@api path /api/* /healthz
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:8080
	}
}

:8080 {
	import forgeflow_proxy
}

https://{$FORGEFLOW_PUBLIC_IP} {
	tls {
		issuer acme {
			profile shortlived
			disable_http_challenge
		}
	}

	import forgeflow_proxy
}
