[Unit]
Description=ForgeFlow personal preview sanitized operations snapshot
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=forgeflow
Group=forgeflow
WorkingDirectory=/srv/forgeflow/app
ExecStart=/usr/bin/python3 -B scripts/personal_preview_operations.py observe --env-file deploy/personal-preview/preview.env --backup-directory /srv/forgeflow/backups --data-path /srv/forgeflow --output-directory /srv/forgeflow/operations/observations
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/forgeflow/operations/observations
StandardOutput=journal
StandardError=journal
