[Unit]
Description=ForgeFlow personal preview PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=forgeflow
Group=forgeflow
WorkingDirectory=/srv/forgeflow/app
Environment=BACKUP_RETENTION_DAYS=14
Environment=FORGEFLOW_BACKUP_PATH=/srv/forgeflow/backups
ExecStart=/usr/bin/docker compose --env-file deploy/personal-preview/preview.env -f deploy/personal-preview/compose.yaml -f deploy/personal-preview/compose.backup.yaml --profile ops run --rm backup
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/forgeflow/backups
