FORGEFLOW_RELEASE=0.1.0-preview.1
FORGEFLOW_GIT_COMMIT=<approved-40-character-git-sha>
FORGEFLOW_REPOSITORY_PATH=/srv/forgeflow/repositories
FORGEFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
ALPINE_REPOSITORY_URL=https://dl-cdn.alpinelinux.org/alpine
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org
FORGEFLOW_INSTALL_DOCKER_CLI=false
POSTGRES_IMAGE=postgres:17-alpine
CADDY_IMAGE=caddy:2.11.4-alpine

# Optional public-IP HTTPS overlay (compose.public-ip.yaml only).
# Uncomment both lines and replace the contact email before enabling the overlay.
# FORGEFLOW_PUBLIC_IP=39.102.136.31
# FORGEFLOW_ACME_EMAIL=admin@example.com
