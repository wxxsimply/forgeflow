FORGEFLOW_ENV=development
FORGEFLOW_LOG_LEVEL=info
FORGEFLOW_SERVICE_VERSION=development
# Leave empty to use safe no-op tracing without requiring a Collector.
FORGEFLOW_OTEL_ENDPOINT=
FORGEFLOW_OTEL_SAMPLE_RATIO=0.1
FORGEFLOW_METRICS_ENABLED=true
FORGEFLOW_DATA_DIR=.forgeflow
# development 装配完整 Developer/Test/Reviewer/Security/Judge Graph，并要求 OpenAI + Docker；planning 仅用于无模型、无沙箱的界面演示。
FORGEFLOW_WORKFLOW_MODE=planning
FORGEFLOW_PLANNER_MODE=mock

# HTTP API。生产环境必须通过 HTTPS，并保持 Secure Cookie。
FORGEFLOW_HTTP_ADDRESS=127.0.0.1:8080
FORGEFLOW_HTTP_COOKIE_SECURE=true
# FORGEFLOW_HTTP_COOKIE_DOMAIN=forgeflow.example.com
# FORGEFLOW_HTTP_ALLOWED_ORIGINS=https://forgeflow.example.com
FORGEFLOW_REPOSITORY_ROOTS=.
FORGEFLOW_SESSION_TTL=24h
FORGEFLOW_SESSION_IDLE_TTL=30m
# 仅首次启动且 users 表为空时使用；创建成功后立刻从服务器环境移除。
# FORGEFLOW_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# FORGEFLOW_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-bytes

# 仅在 FORGEFLOW_PLANNER_MODE=openai 时启用 OpenAI-compatible Provider。不要在本文件中填写真实密钥。
# OPENAI_API_KEY=
# DeepSeek Responses API 可改为 https://api.deepseek.com，并把各 Agent 模型改为同一个受支持的 DeepSeek 模型。
FORGEFLOW_MODEL_PROVIDER=openai
FORGEFLOW_OPENAI_BASE_URL=https://api.openai.com/v1
FORGEFLOW_OPENAI_MAX_RETRIES=2
FORGEFLOW_PLANNER_MODEL=gpt-5.6
FORGEFLOW_PLANNER_PROMPT_VERSION=planner/v1
FORGEFLOW_PLANNER_REASONING_EFFORT=medium
FORGEFLOW_PLANNER_MAX_OUTPUT_TOKENS=4000
FORGEFLOW_PLANNER_TIMEOUT=120s

# 按所选模型的当前价格显式配置；为 0 时仍记录 Token，但不声称成本估算准确。
FORGEFLOW_PLANNER_INPUT_USD_PER_MTOK=0
FORGEFLOW_PLANNER_OUTPUT_USD_PER_MTOK=0

# Developer 使用同一个 Provider 凭据，但拥有独立 Prompt、上下文和输出预算。
FORGEFLOW_DEVELOPER_MODEL=gpt-5.6
FORGEFLOW_DEVELOPER_PROMPT_VERSION=developer/v1
FORGEFLOW_DEVELOPER_REASONING_EFFORT=medium
FORGEFLOW_DEVELOPER_MAX_OUTPUT_TOKENS=16000
FORGEFLOW_DEVELOPER_TIMEOUT=5m
FORGEFLOW_DEVELOPER_CONTEXT_MAX_BYTES=131072

# Reviewer and Security use independent prompts and evidence-only contexts.
FORGEFLOW_REVIEWER_MODEL=gpt-5.6
FORGEFLOW_REVIEWER_PROMPT_VERSION=reviewer/v1
FORGEFLOW_REVIEWER_REASONING_EFFORT=medium
FORGEFLOW_REVIEWER_MAX_OUTPUT_TOKENS=3000
FORGEFLOW_REVIEWER_TIMEOUT=2m
FORGEFLOW_REVIEWER_CONTEXT_MAX_BYTES=524288
FORGEFLOW_SECURITY_MODEL=gpt-5.6
FORGEFLOW_SECURITY_PROMPT_VERSION=security/v1
FORGEFLOW_SECURITY_REASONING_EFFORT=medium
FORGEFLOW_SECURITY_MAX_OUTPUT_TOKENS=3000
FORGEFLOW_SECURITY_TIMEOUT=2m
FORGEFLOW_SECURITY_CONTEXT_MAX_BYTES=524288

# PostgreSQL migrations are run explicitly; application startup only checks schema version.
FORGEFLOW_POSTGRES_ENABLED=false
# FORGEFLOW_POSTGRES_DSN=postgres://forgeflow:replace-me@127.0.0.1:5432/forgeflow?sslmode=require
FORGEFLOW_POSTGRES_MAX_OPEN_CONNS=20
FORGEFLOW_POSTGRES_MAX_IDLE_CONNS=5
FORGEFLOW_POSTGRES_CONN_MAX_LIFETIME=30m
FORGEFLOW_POSTGRES_PING_TIMEOUT=5s

# Artifact bodies remain outside PostgreSQL; only metadata is stored in the database.
FORGEFLOW_ARTIFACT_ROOT=.forgeflow/artifacts
FORGEFLOW_ARTIFACT_MAX_BYTES=67108864

FORGEFLOW_WORKER_LEASE_TTL=30s
FORGEFLOW_WORKER_HEARTBEAT_INTERVAL=10s
FORGEFLOW_WORKER_POLL_INTERVAL=500ms
FORGEFLOW_WORKER_METRICS_ADDRESS=127.0.0.1:9091

# Sensitive values may be read from Docker/Kubernetes Secret files. Never set a
# direct value and its _FILE variant at the same time.
# FORGEFLOW_POSTGRES_DSN_FILE=/run/secrets/postgres_dsn
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# FORGEFLOW_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password

# 真实命令只允许在受管 worktree 的 Docker 沙箱中执行，默认关闭。
# 启用时镜像必须固定到 sha256 digest，不能使用 latest 或普通 tag。
FORGEFLOW_DOCKER_ENABLED=false
FORGEFLOW_DOCKER_BINARY=docker
FORGEFLOW_SANDBOX_WORKSPACE_ROOT=.forgeflow/workspaces
# FORGEFLOW_SANDBOX_IMAGE=forgeflow-sandbox@sha256:<64位小写十六进制摘要>
FORGEFLOW_SANDBOX_CPUS=1.0
FORGEFLOW_SANDBOX_MEMORY=512m
FORGEFLOW_SANDBOX_PIDS_LIMIT=128
FORGEFLOW_SANDBOX_TMPFS_BYTES=67108864
FORGEFLOW_SANDBOX_MAX_OUTPUT_BYTES=2097152
FORGEFLOW_SANDBOX_TIMEOUT=10m
